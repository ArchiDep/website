#!/usr/bin/env bash
set -e

compose="docker compose -f compose.dev.yml"

mkdir -p tmp/docker/dev
chmod 700 tmp/docker/dev

# Created here rather than by Docker so that it belongs to the developer: it is
# also read by a machine-native run, at the same path.
mkdir -p tmp/course_site_archives

# Phase 1: Download the application's Elixir dependencies which are needed to
# compile the application assets and the theme.
$compose build app
$compose run --entrypoint /usr/local/bin/deps.sh --no-deps --rm app

# Phase 2: Fetch the finished editions of the course, which this repository does
# not hold and the application serves beside the one it renders, then install
# Node.js dependencies.
$compose build archives
$compose run --rm archives

$compose build node
$compose run --rm node

# Compile remaining Docker images.
$compose build app-assets course-assets theme

# Delete these files that are used by the various health checks to know when
# each component is ready.
rm -f tmp/docker/dev/app/priv/static/assets/app/app.js \
      tmp/docker/dev/app/priv/static/assets/course/course.js \
      tmp/docker/dev/app/priv/static/assets/theme/theme.css

# Phases 3-5: Run everything. Services will wait for each other to be healthy
# before starting.
exec $compose up --force-recreate app app-assets course-assets theme db
