#!/bin/bash
#
# The remote land of Avalon, the SSH follow-up to the treasure hunt of the
# "Hello Shell" exercise of the ArchiDep course.
#
# This is the first gate: the barge that takes a student to Avalon. It is
# installed on the SSH exercise server, in /usr/local/bin, so that students
# run it by its name once they are logged in. When it opens, it builds the rest
# of the land in ~/avalon, in the student's own home directory: Merlin, who
# holds the prophecy and the Lady of the Lake. Run "dock --restart" to start
# over: it asks before it deletes the old land.
#
# Warning: spoilers. This file contains the whole of Avalon, solution included.
#
# It runs on the server, but the prophecy it writes runs on the students' own
# machines: that one must work with the Bash 3.2 that macOS includes and with
# the GNU tools of the WSL.
#
# The barge only takes students who logged in with their key. It knows how they
# logged in from the file named in SSH_USER_AUTH, which the SSH server only
# writes when its configuration has "ExposeAuthInfo yes".

# Since Bash 5.2, an "&" in the replacement of ${value//pattern/replacement}
# stands for the text that matched, which would break the "&&" of the gates
# below.
shopt -u patsub_replacement 2> /dev/null

# The edition of the course this land belongs to. Every page of the site is
# published under the starting year of its academic year, so the year is the
# first segment of every address the land sends students to. It moves at the
# year-end rollover, with the rest of the edition.
CURRENT_YEAR=2026

# Where the exercise is published, which every text that sends students there
# writes as @@EXERCISE@@, followed by the anchor of a section.
EXERCISE="https://archidep.ch/$CURRENT_YEAR/course/104-hello-ssh/"

# The port of the impostor's SSH server, which the message left on the shore
# sends students to.
IMPOSTOR_PORT=2222

# The public host key of that impostor, on this machine. The Lady of the Lake
# reads it to tell whether the fingerprint a student brings back is the one the
# impostor showed them, so this file must stay readable by everyone.
IMPOSTOR_KEY=/etc/ssh/avalon-impostor/ssh_host_ed25519_key.pub

# Where this machine keeps its own public host keys, which are the fingerprints
# the dashboard lists. A student who brings one of these back read the wrong
# server's key.
HOST_KEYS='/etc/ssh/ssh_host_*_key.pub'

# The words the prophecy can give. One is drawn for each student.
WORDS=(
  EXCALIBUR PENDRAGON CAMELOT GRAIL TINTAGEL BROCELIANDE
  LANCELOT GAWAIN PERCEVAL GUINEVERE ROUNDTABLE LYONESSE
)

# Reads a heredoc into the variable named by $1, exactly as written, leading
# spaces included.
text() {
  IFS= read -r -d '' "$1" || true
}

# What the gates say is sealed with the cipher of Julius Caesar, as in the
# treasure hunt: every letter and digit is shifted 3 places further, and turned
# back when the gate speaks. The programs a gate holds are sealed inside it,
# which shifts the innermost ones several times over.
CAESAR_PLAIN='A-Za-z0-9'
CAESAR_SEALED='D-ZA-Cd-za-c3-90-2'

# The commands that work with sealed texts, which every gate includes, with the
# text on their input: reveal prints it unsealed, unpack <file> <mode> writes it
# unsealed, and seal prints it sealed.
UNPACK="reveal() { LC_ALL=C tr '$CAESAR_SEALED' '$CAESAR_PLAIN'; }
unpack() { reveal > \"\$1\" && chmod \"\$2\" \"\$1\"; }
seal() { LC_ALL=C tr '$CAESAR_PLAIN' '$CAESAR_SEALED'; }"

# Prints a text with its placeholders replaced.
fill() {
  local value="$1"
  value=${value//@@AVALON@@/$AVALON}
  value=${value//@@LOGIN@@/$LOGIN}
  value=${value//@@HOST@@/$HOST}
  value=${value//@@PORT@@/$IMPOSTOR_PORT}
  value=${value//@@IMPOSTOR_KEY@@/$IMPOSTOR_KEY}
  value=${value//@@HOST_KEYS@@/$HOST_KEYS}
  value=${value//@@EXERCISE@@/$EXERCISE}
  value=${value//@@UNPACK@@/$UNPACK}
  value=${value//@@WORD@@/$WORD}
  value=${value//@@SEALED_WORD@@/$SEALED_WORD}
  printf '%s' "$value"
}

# Prints a text, placeholders replaced, sealed with the cipher of Caesar.
pack() {
  fill "$1" | LC_ALL=C tr "$CAESAR_PLAIN" "$CAESAR_SEALED"
}

# Seals the text in the variable named by $3 into the text in the variable
# named by $1, in place of the placeholder @@$2@@. The placeholder is the body
# of a heredoc ending with SEALED_$2, a line no sealed text can hold: it is
# shifted with the rest at every level.
embed() {
  local parent="${!1}" child
  heredoc_body child "${!3}"
  printf -v "$1" '%s' "${parent//@@$2@@/$child}"
}

# Sets the variable named by $1 to the text $2 sealed, as the body of a heredoc:
# without its last newline, which the heredoc gives it back.
heredoc_body() {
  local sealed
  # The x keeps the newlines the text ends with, which $(...) would remove.
  sealed=$(pack "$2"; echo x)
  sealed=${sealed%x}
  printf -v "$1" '%s' "${sealed%$'\n'}"
}

# Writes a text into a file: put <file> <text> [<mode>]
put() {
  fill "$2" > "$1" && chmod "${3:-644}" "$1"
}

fail() {
  echo "$*" >&2
  exit 1
}

