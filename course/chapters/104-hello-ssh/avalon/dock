# ---------------------------------------------------------------------------
# Building Avalon
# ---------------------------------------------------------------------------

# The end of every program of Avalon, which is what cat leaves on screen when a
# student reads one instead of running it. @@RUN@@ is how to run it.
text SCRIPT_END <<'END_SCRIPT_END'










# ======================================================================
# ======================================================================
#
#    HALT, TRAVELLER!
#
#    This is not a scroll to read. It is a magic spell, and you are
#    looking at the words inside it. Reading a spell does nothing:
#    you have to cast it. Cast it like this:
#
#        @@RUN@@
#
#    (Curious travellers are allowed to read spells. Some find
#    interesting things inside. But nothing happens until you cast it.)
#
# ======================================================================
# ======================================================================
END_SCRIPT_END

# Adds the end above to the program in the variable named by $1, which is run
# with $2.
script_end() {
  local script="${!1}"
  printf -v "$1" '%s%s' "$script" "${SCRIPT_END//@@RUN@@/$2}"
}

# Seals what the program in the variable named by $1 says. It is written here
# in plain text, in heredocs ending with a line that says SEALED, which is what
# reveal prints; their text is sealed here, so that reading the program does
# not tell what happens on Avalon.
seal_messages() {
  local program="${!1}" sealed="" line message="" body in_message=0
  while IFS= read -r line; do
    if [ "$in_message" -eq 1 ]; then
      if [ "$line" = "SEALED" ]; then
        heredoc_body body "$message"
        sealed="$sealed$body
SEALED
"
        message="" in_message=0
      else
        message="$message$line
"
      fi
    else
      sealed="$sealed$line
"
      case "$line" in
        *"<<'SEALED'"*) in_message=1 ;;
      esac
    fi
  # <<< ends the program with a newline of its own, one too many.
  done <<< "${program%$'\n'}"
  printf -v "$1" '%s' "$sealed"
}

build() {
  script_end MERLIN './merlin'
  script_end PROPHECY './prophecy     (on your own computer)'
  script_end LADY 'ssh @@LOGIN@@ ./avalon/lady THE-WORD     (from your own computer)'

  local program
  for program in MERLIN PROPHECY LADY; do
    seal_messages "$program"
  done

  embed LADY MESSAGE MESSAGE
  embed LADY SHORE_HINT SHORE_HINT
  embed LADY FINAL_HINT FINAL_HINT
  embed MERLIN PROPHECY PROPHECY
  embed MERLIN LADY LADY
  # The prophecy is read on the student's own computer, where it cannot change
  # the hint of Avalon: the hint Merlin leaves covers the Lady of the Lake too.
  local merlin_hint="$PROPHECY_HINT
------------------------------------------------------------------------

$LADY_HINT"
  embed MERLIN PROPHECY_HINT merlin_hint

  mkdir -p "$AVALON" || return 1
  put "$AVALON/merlin" "$MERLIN" 755
  put "$AVALON/.hint" "$DOCK_HINT"
  # Every place of the treasure hunt has a hint, so students reach for cat
  # .hint as soon as they land, before they have gone into Avalon. The home
  # directory they land in answers with the way there.
  put "$HOME/.hint" "$HOME_HINT"
}

# Asks before deleting a land that already exists.
confirm_restart() {
  local answer=""

  printf 'Delete Avalon and start again from the beginning? [y/N] '
  read -r answer || true
  # Separates what either answer leads to from the line it was typed on, and
  # ends that line itself when the answer came from an end of input rather than
  # from a traveller pressing enter.
  printf '\n'

  case "$answer" in
    y|Y|yes|YES|Yes) return 0 ;;
    *) fail "Nothing was changed. Avalon is still in $AVALON." ;;
  esac
}

main() {
  local restart=no

  case "${1:-}" in
    --restart) restart=yes ;;
    '') ;;
    *) fail "Usage: dock [--restart]" ;;
  esac

  if [ -z "${HOME:-}" ] || [ "$HOME" = "/" ] || [ ! -d "$HOME" ]; then
    fail "Your home directory was not found. Nothing was changed."
  fi

  AVALON="$HOME/avalon"
  HOST=$(hostname)
  LOGIN="$(id -un)@$HOST"
  WORD=${WORDS[RANDOM % ${#WORDS[@]}]}
  SEALED_WORD=$(printf '%s' "$WORD" | LC_ALL=C tr "$CAESAR_PLAIN" "$CAESAR_SEALED")

  printf '%s' "$BARGE"

  if [ -z "${SSH_CONNECTION:-}" ]; then
    fill "$NO_SSH"
    exit 1
  fi

  if [ -z "${SSH_USER_AUTH:-}" ] || [ ! -r "$SSH_USER_AUTH" ]; then
    fill "$BROKEN"
    exit 1
  fi

  if ! grep -q '^publickey ' "$SSH_USER_AUTH"; then
    fill "$PASSWORD"
    exit 1
  fi

  if [ -e "$AVALON" ]; then
    if [ "$restart" = no ]; then
      fill "$ALREADY"
      exit 0
    fi
    confirm_restart
    rm -rf "$AVALON" || fail "Could not delete $AVALON."
  fi

  build || fail "Something went wrong while building Avalon in $AVALON."

  fill "$ARRIVAL"
}

# Everything above only defines things. Nothing runs before this last line.
main "$@"
