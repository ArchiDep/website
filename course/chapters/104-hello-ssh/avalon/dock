text MERLIN <<'END_MERLIN'
#!/bin/bash
# Merlin, the enchanter. He loves gifts from faraway lands.
AVALON='@@AVALON@@'
@@UNPACK@@

if [ -f "$AVALON/lady" ]; then
  reveal <<'SEALED'
Merlin smiles. "I gave you the prophecy already. Read it far from
here, in your own land."
SEALED
  exit 0
fi

reveal <<'SEALED'
                 _____
                /     \
               /  * *  \
              /_________\
               | o   o |
               |   >   |
              /|\_____/|\
             / |  \~/  | \
            /  |   ~   |  \
              _|_______|_

SEALED

# A file called treasure that holds no treasure is not nothing: it is a
# traveller who tried the name on its own. Merlin says so rather than greeting
# them as though they had come empty-handed, but it does not stand in the way
# of the other gift, so that nobody has to delete anything to go on.
gift=""
forgery=no
if [ -f "$AVALON/treasure" ]; then
  if grep -q '^# The treasure of Skull Island' "$AVALON/treasure"; then
    gift=treasure
  else
    forgery=yes
  fi
fi

if [ -z "$gift" ] && [ -f "$AVALON/land.txt" ]; then
  gift=land
fi

if [ -z "$gift" ] && [ "$forgery" = yes ]; then
  reveal <<'SEALED'
Merlin picks up the file you called treasure. He turns it over once,
and laughs.

"The right name, traveller, and nothing of Skull Island inside it!
 Did you think the name was the thing? Anyone can write treasure on
 anything. I read what is in it.

 The real one is a program, and it still says where it comes from. It
 is in your bag, on your own computer, and it crosses the sea like
 any other file.

 Never found it? Then tell me instead what your own land answers when
 you ask it who it is, and I will be just as glad."
SEALED
  exit 1
fi

if [ -z "$gift" ]; then
  reveal <<'SEALED'
"Welcome to Avalon, traveller. I am Merlin.

 A parrot told me you would come. It also told me that you came from
 far away. Then bring me a gift from your own land! Two things would
 please me:

 - The treasure of Skull Island, if you found it. Put it here, in
   avalon, and keep its name: treasure.
 - Or, if you did not find it, what your land answers when you ask it
   who it is (uname -a), in a file named land.txt, here in avalon.

 A gift from your land cannot be made here, on Avalon. Make it there,
 and send it across the sea."
SEALED
  exit 1
fi

if [ "$gift" = land ]; then
  if grep -qF "$(uname -n)" "$AVALON/land.txt" || [ "$(cat "$AVALON/land.txt")" = "$(uname -a)" ]; then
    reveal <<'SEALED'
Merlin reads land.txt, and frowns.

"This does not come from your land. It comes from Avalon itself! You
 asked this server who it is, not your own computer. Run uname -a on
 your own computer, and send me what it says."
SEALED
    exit 1
  fi
  if ! grep -Eq '^(Darwin|Linux) [^ ]+ [^ ]+' "$AVALON/land.txt"; then
    reveal <<'SEALED'
Merlin reads land.txt, and shakes his head.

"I cannot read this. I want everything your computer says when you
 run uname -a, exactly as it says it."
SEALED
    exit 1
  fi
fi

if [ "$gift" = treasure ]; then
  reveal <<'SEALED'
Merlin holds the treasure of Skull Island in his hands. His eyes
shine.

"So the treasure of Skull Island is real! I have waited so long to
 see it. And look: it still says where it comes from."
SEALED
  case "$(sed -n "s/^HUNT='\(.*\)'$/\1/p" "$AVALON/treasure")" in
    /Users/*)
      reveal <<'SEALED'

"In your land, homes are in /Users. You come from a Mac!"
SEALED
      ;;
    /home/*)
      reveal <<'SEALED'

"In your land, homes are in /home. You come from Linux: the WSL on
 Windows, maybe?"
SEALED
      ;;
  esac
  reveal <<'SEALED'

"Now, try this: type treasure, here on Avalon, and see what happens.
 Command not found! Your bag is not in the PATH of Avalon: your PATH
 stayed on your own computer, with the rest of your settings. But the
 treasure is a program, and a program is a file: here, ./treasure
 works."
SEALED
else
  reveal <<'SEALED'
Merlin reads land.txt carefully.

"So this is how your land answers! It is not Avalon's answer:
 Avalon's would carry the name of this server."
SEALED
  if grep -q '^Darwin' "$AVALON/land.txt"; then
    reveal <<'SEALED'

"Darwin... You come from a Mac!"
SEALED
  elif grep -qi 'microsoft' "$AVALON/land.txt"; then
    reveal <<'SEALED'

"Linux, made by Microsoft... You come from the WSL, on Windows!"
SEALED
  else
    reveal <<'SEALED'

"Linux... You come from a land much like this one."
SEALED
  fi
fi

unpack "$AVALON/prophecy" 755 <<'SEALED_PROPHECY' &&
@@PROPHECY@@
SEALED_PROPHECY
unpack "$AVALON/lady" 755 <<'SEALED_LADY' &&
@@LADY@@
SEALED_LADY
unpack "$AVALON/.hint" 644 <<'SEALED_PROPHECY_HINT' || exit 1
@@PROPHECY_HINT@@
SEALED_PROPHECY_HINT

reveal <<'SEALED'

"In exchange, here is a prophecy. I wrote it with a magic ink that
 only shows far from Avalon: here, it looks blank. Take it home, to
 your own computer, and read it there."

