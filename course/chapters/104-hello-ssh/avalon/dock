text MERLIN <<'END_MERLIN'
#!/bin/bash
# Merlin, the enchanter. He loves gifts from faraway lands.
AVALON='@@AVALON@@'
@@UNPACK@@

if [ -f "$AVALON/lady" ]; then
  reveal <<'SEALED'
Merlin smiles. "I gave you the prophecy already. Read it far from
here, on your own computer."
SEALED
  exit 0
fi

reveal <<'SEALED'
                 _____
                /  *  \
               /_______\
               | o   o |
               |   >   |
              /|\_~~~_/|\

SEALED

# A file called treasure that holds no treasure is not nothing: it is a
# traveller who tried the name on its own. Merlin says so rather than greeting
# them as though they had come empty-handed, but it does not stand in the way
# of the other gift, so that nobody has to delete anything to go on.
gift=""
forgery=no
if [ -f "$AVALON/treasure" ]; then
  if grep -q '^# The treasure of Skull Island' "$AVALON/treasure"; then
    gift=treasure
  else
    forgery=yes
  fi
fi

if [ -z "$gift" ] && [ -f "$AVALON/land.txt" ]; then
  gift=land
fi

if [ -z "$gift" ] && [ "$forgery" = yes ]; then
  reveal <<'SEALED'
Merlin reads the file you called treasure, and laughs.

"The right name, and nothing of Skull Island inside! Anyone can name
 a file treasure. I read what is in it.

 The real treasure is a program, in your bag on your own computer.
 Never found it? Then bring me what your computer says about itself
 (uname -a), in a file named land.txt."
SEALED
  exit 1
fi

if [ -z "$gift" ]; then
  reveal <<'SEALED'
"Welcome to Avalon, traveller. I am Merlin. A parrot told me you came
 from far away. Then bring me a gift from your own land:

 - the treasure of Skull Island, if you found it, named treasure;
 - or what your computer says about itself (uname -a), in a file
   named land.txt.

 Put it here, in avalon. You cannot make it here: make it on your
 own computer, and send it across the sea."
SEALED
  exit 1
fi

if [ "$gift" = land ]; then
  if grep -qF "$(uname -n)" "$AVALON/land.txt" || [ "$(cat "$AVALON/land.txt")" = "$(uname -a)" ]; then
    reveal <<'SEALED'
Merlin reads land.txt, and frowns.

"This does not come from your land. It comes from Avalon itself! You
 ran uname -a on this server. Run it on your own computer, and send
 me what it says."
SEALED
    exit 1
  fi
  if ! grep -Eq '^(Darwin|Linux) [^ ]+ [^ ]+' "$AVALON/land.txt"; then
    reveal <<'SEALED'
Merlin reads land.txt, and shakes his head.

"I cannot read this. Send me exactly what uname -a says on your own
 computer."
SEALED
    exit 1
  fi
fi

# What Merlin says about the gift is one paragraph, opened here and closed by
# the line on where the traveller comes from, or on the PATH for a treasure.
if [ "$gift" = treasure ]; then
  reveal <<'SEALED'
"The treasure of Skull Island! So it is real, and it still says
 where it comes from.
SEALED
  case "$(sed -n "s/^HUNT='\(.*\)'$/\1/p" "$AVALON/treasure")" in
    /Users/*)
      reveal <<'SEALED'
 In your land, homes are in /Users: you come from a Mac!
SEALED
      ;;
    /home/*)
      reveal <<'SEALED'
 In your land, homes are in /home: you come from Linux, or the WSL!
SEALED
      ;;
  esac
  reveal <<'SEALED'

 Now type treasure here. Command not found? Your PATH stayed on your
 own computer, with your other settings. But a program is a file, so
 ./treasure works here."
SEALED
else
  reveal <<'SEALED'
Merlin reads land.txt carefully.

"So this is what your land says! It is not Avalon's answer, which
 would have the name of this server.
SEALED
  if grep -q '^Darwin' "$AVALON/land.txt"; then
    reveal <<'SEALED'
 Darwin... You come from a Mac!"
SEALED
  elif grep -qi 'microsoft' "$AVALON/land.txt"; then
    reveal <<'SEALED'
 Linux, made by Microsoft... You come from the WSL, on Windows!"
SEALED
  else
    reveal <<'SEALED'
 Linux... You come from a land much like this one."
SEALED
  fi
fi

unpack "$AVALON/prophecy" 755 <<'SEALED_PROPHECY' &&
@@PROPHECY@@
SEALED_PROPHECY
unpack "$AVALON/lady" 755 <<'SEALED_LADY' &&
@@LADY@@
SEALED_LADY
unpack "$AVALON/.hint" 644 <<'SEALED_PROPHECY_HINT' || exit 1
@@PROPHECY_HINT@@
SEALED_PROPHECY_HINT

reveal <<'SEALED'

"In exchange, take this prophecy. Its magic ink only shows far from
 Avalon: here, it is blank. Read it on your own computer."

            ()___________________)
             |  ~~~~ ~~~ ~~~~   |    Merlin puts the prophecy next
             |  ~~~ ~~~~ ~~~    |    to him, in ~/avalon: prophecy.
            ()___________________)
SEALED
END_MERLIN

text PROPHECY_HINT <<'END_PROPHECY_HINT'
HINT

1. The prophecy is in ~/avalon. Copy it to your computer and run it:

       scp @@LOGIN@@:avalon/prophecy .
       ./prophecy

   The server comes first, because the file comes from there. The dot
   (.) is where it goes: the directory you are in, on your computer.
   "Permission denied"? Run chmod +x prophecy, as on Skull Island.
END_PROPHECY_HINT

