# ---------------------------------------------------------------------------
# The Lady of the Lake
# ---------------------------------------------------------------------------

text LADY <<'END_LADY'
#!/bin/bash
# The Lady of the Lake. She only speaks to those who do not stay.
AVALON='@@AVALON@@'
HOST_KEYS='@@HOST_KEYS@@'
@@UNPACK@@

# Where the impostor's key is on this machine. It is sealed like everything
# else of Avalon: a traveller who reads this spell before going to the shore
# should not find the answer written in it in plain sight.
IMPOSTOR_KEY=$(reveal <<'SEALED'
@@IMPOSTOR_KEY@@
SEALED
)

# Prints the SHA256 fingerprint of the public key in the file $1, and nothing
# at all if there is no key to read there.
fingerprint_of() {
  ssh-keygen -l -f "$1" 2> /dev/null |
    LC_ALL=C grep -o 'SHA256:[A-Za-z0-9+/=]*'
}

# SSH gives a terminal to someone who logs in, and names it in SSH_TTY. A
# command sent with "ssh <server> <command>" gets none.
if [ -n "${SSH_TTY:-}" ]; then
  reveal <<'SEALED'
       ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
         ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

The lake is still. Nobody answers.

The Lady of the Lake does not speak to travellers who stay on Avalon,
and you are logged in to this server. Log out with exit, and call her
from your own computer.
SEALED
  exit 1
fi

# A command this server sends to itself, with "ssh <server> <command>" typed
# while logged in, gets no terminal either, but it comes from Avalon all the
# same. SSH_CONNECTION begins with the address the connection came from, which
# is then one of this machine's own.
from=${SSH_CONNECTION%% *}
here=no
case "$from" in
  127.* | ::1) here=yes ;;
  *)
    for address in $(hostname -I 2> /dev/null); do
      if [ "$address" = "$from" ]; then
        here=yes
      fi
    done
    ;;
esac

if [ "$here" = yes ]; then
  reveal <<'SEALED'
       ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
         ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

The lake is still. Nobody answers.

The Lady of the Lake does not speak to travellers who stay on Avalon,
and this call comes from Avalon: you sent it from this server. Log
out with exit, and call her from your own computer.
SEALED
  exit 1
fi

if [ "$#" -eq 0 ]; then
  reveal <<'SEALED'
A voice rises from the lake: "Who calls me? Say the word, traveller.
Write it after my name."
SEALED
  exit 1
fi

# A traveller who comes back from the shore brings a fingerprint next to the
# word. The two are told apart by the SHA256: that every fingerprint begins
# with, so they can be given in either order, and whatever a student pasted
# around a fingerprint is trimmed off it.
fingerprint=""
for arg in "$@"; do
  case "$arg" in
    *SHA256:*)
      rest=${arg#*SHA256:}
      fingerprint="SHA256:${rest%%[!A-Za-z0-9+/=]*}"
      ;;
  esac
done

# Each argument is searched on its own, so that whatever was pasted next to
# the word does not hide it, and then all of them at once, so that a word
# typed in two pieces still counts.
word=no
for candidate in "$@" "$*"; do
  candidate=$(printf '%s' "${candidate%%SHA256:*}" |
    LC_ALL=C tr 'a-z' 'A-Z' | LC_ALL=C tr -cd 'A-Z')
  if [ -n "$candidate" ] &&
    [ "$(printf '%s' "$candidate" | seal)" = '@@SEALED_WORD@@' ]; then
    word=yes
  fi
done

if [ "$word" = no ]; then
  if [ -n "$fingerprint" ]; then
    reveal <<'SEALED'
A voice rises from the lake: "You bring me a key, traveller, but not
the word. Say the word of the prophecy too, before the key."
SEALED
  else
    reveal <<'SEALED'
A voice rises from the lake: "That is not the word, traveller. Read
the prophecy again."
SEALED
  fi
  exit 1
fi

# The last trial: a traveller who has already been to the shore comes back with
# the fingerprint of the key that answered there. A fingerprint brought before
# the message was left falls through to the scene below, which asks for it.
if [ -n "$fingerprint" ] && [ -f "$AVALON/message.txt" ]; then
  # Both keys are read here, on this machine, where they are: the fingerprint a
  # student brings back is compared with the real thing, not with a copy
  # written into this spell.
  impostor=$(fingerprint_of "$IMPOSTOR_KEY")

  # A land that cannot read that key cannot tell it from any other, and the
  # trial it is the answer to does not exist on such a machine either. The lake
  # says so and gives nothing: a dead end a teacher can hear about is worth
  # more than Excalibur handed to whoever types the right shape.
  if [ -z "$impostor" ]; then
    reveal <<'SEALED'
The lake goes dark. Avalon is broken: the Lady of the Lake cannot
read the key you ask her about.

This is not your fault. Tell your teacher that she cannot read the
host key of the server on port @@PORT@@.
SEALED
    exit 1
  fi

  mine=no
  for key in $HOST_KEYS; do
    if [ "$(fingerprint_of "$key")" = "$fingerprint" ]; then
      mine=yes
    fi
  done

  if [ "$mine" = yes ]; then
    reveal <<'SEALED'
A voice rises from the lake: "That is my own key, traveller: the key
of this server, listed on the dashboard. Bring me the key you were
shown on the other port, on the line that begins with SHA256."
SEALED
    exit 1
  fi

  if [ "$fingerprint" != "$impostor" ]; then
    reveal <<'SEALED'
A voice rises from the lake: "I do not know that key, traveller. Your
computer shows a server's key before it asks if you trust it, on the
line that begins with SHA256. Bring me all of it."
SEALED
    exit 1
  fi

  unpack "$AVALON/.hint" 644 <<'SEALED_FINAL_HINT' || exit 1
@@FINAL_HINT@@
SEALED_FINAL_HINT

  # What tells the lake, when a traveller calls again with only the word, that
  # it has nothing left to ask them for. Calling again with the key replays the
  # whole ending, which is checked above and before this.
  touch "$AVALON/.excalibur"

  # The sword comes first and the words after it, so that what a traveller
  # reads last is what stays on screen.
  reveal <<'SEALED'
                            /\
                           |  |
                           |  |
                      =====|  |=====
                           |__|
                          (____)
       ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

"That key is not mine: it belongs to Morgan le Fay. She wrote the
 message, and waited for you on that other port with a false
 Excalibur.
SEALED

  # The server on the other port marks the travellers who got as far as
  # telling it who they were, which is something only a client that accepted
  # its key ever does. Nothing marks the ones who refused, so the lake speaks
  # of what it can see rather than of what it cannot.
  if [ -f "$AVALON/.morgan" ]; then
    reveal <<'SEALED'

 You said yes before you checked her key. Your key was safe, but a
 password would now be hers. Take the real Excalibur, and go home."

      EXCALIBUR IS YOURS, AND AVALON IS BEHIND YOU.

Your computer still trusts Morgan. Make it forget her, on your own
computer:

    ssh-keygen -R '[@@HOST@@]:@@PORT@@'
SEALED
  else
    reveal <<'SEALED'

 You checked her key, and you refused it: that is what a careful
 traveller does. Take the real Excalibur, and go home."

      EXCALIBUR IS YOURS, AND AVALON IS BEHIND YOU.
SEALED
  fi
  exit 0
fi

# The scene below is played once. A traveller who comes back with only the word
# has it already, and wants the one thing they are missing rather than all of it
# again.
if [ -f "$AVALON/.excalibur" ]; then
  reveal <<'SEALED'
A voice rises from the lake: "You have Excalibur, traveller, and
Avalon is behind you. Go home."
SEALED
  exit 0
fi

if [ -f "$AVALON/message.txt" ]; then
  reveal <<'SEALED'
A voice rises from the lake: "I am still waiting, traveller. Read the
message on the shore, ~/avalon/message.txt, and bring me the key of
whatever answers at the end of it:

    ssh @@LOGIN@@ ./avalon/lady THE-WORD SHA256:..."
SEALED
  exit 1
fi

unpack "$AVALON/message.txt" 644 <<'SEALED_MESSAGE' &&
@@MESSAGE@@
SEALED_MESSAGE
unpack "$AVALON/.hint" 644 <<'SEALED_SHORE_HINT' || exit 1
@@SHORE_HINT@@
SEALED_SHORE_HINT

reveal <<'SEALED'
                          |
                         _|_
                        (___)
                         /|\
       ~~~~~~~~~~~~~~~~~ \|/ ~~~~~~~~~~~~~~~~~~~~~~~~

An arm rises from the lake, holding a sword: Excalibur. A voice says:

"You called me from your own land, and my words cross the sea to
 your terminal: that is the magic of SSH.
SEALED

if [ -f "$AVALON/treasure" ]; then
  reveal <<'SEALED'
 The parrot followed the treasure of Skull Island all the way here.
SEALED
else
  reveal <<'SEALED'
 The parrot heard the words of your own land, and followed you here.
SEALED
fi

reveal <<'SEALED'
 It was never lost: it came to show you the way, and now it waits
 for you at home, on your own computer."

             ,
            (o>    SQUAWK! Home! Home!
            //\
            V_/_

"One last trial: someone left you a message on the shore, in
 ~/avalon/message.txt. Trust nothing you have not checked. Bring me
 the key of whatever answers there, and Excalibur is yours."
SEALED
END_LADY

