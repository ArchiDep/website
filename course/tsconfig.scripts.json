{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2024",
    // The definitions of the diagrams are beside the diagrams, outside `src`.
    "rootDir": "."
  },
  "include": [
    // What the screenshot script reads of the page's globals, such as its deck.
    "./src/assets/globals.d.ts",
    "./src/scripts/**/*.ts",
    "./src/diagrams/build/**/*.ts",
    "./diagrams/**/*.ts",
    "./src/utils/**/*.ts"
  ]
}
