{
  "name": "@archidep/course",
  "version": "0.0.0",
  "description": "Media engineering architecture and deployment course",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "concurrently --group --timings npm:format npm:typecheck npm:test \"npm:diagrams -- --check\" npm:check:assets",
    "check:assets": "npm run build && npm run check:relative-assets",
    "check:relative-assets": "tsx src/scripts/check-relative-assets.ts",
    "check:write": "concurrently --group --timings npm:format:write npm:diagrams && concurrently --group --timings npm:typecheck npm:test npm:check:assets",
    "diagrams": "tsx src/diagrams/build/cli.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "pdf": "tsx src/scripts/pdf.ts",
    "screenshot": "tsx src/scripts/screenshot.ts",
    "start": "node build.mjs --watch",
    "test": "tsx --test 'src/**/*.test.ts' 'diagrams/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.assets.json && tsc --noEmit -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@alphahydrae/simgit": "~0.3.0-beta.2",
    "@iconify-json/fluent": "^1.2.28",
    "@mobily/ts-belt": "^4.0.0-rc.5",
    "@preact/signals": "^2.3.1",
    "@types/chance": "^1.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/lunr": "^2.3.7",
    "@types/luxon": "^3.6.2",
    "@types/node": "^26.6.5",
    "@types/phoenix": "^1.6.6",
    "@types/progress": "^2.0.7",
    "@types/react": "^19.1.14",
    "@types/tippy.js": "^6.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "chance": "^1.1.13",
    "clipboard": "^2.0.11",
    "companion-gate": "~0.4.2",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.0",
    "fp-ts": "^2.16.10",
    "github-slugger": "^2.0.0",
    "iconify-icon": "^3.0.0",
    "io-ts": "^2.2.22",
    "lodash-es": "^4.17.21",
    "loglevel": "^1.9.2",
    "loglevel-plugin-prefix": "^0.8.4",
    "lunr": "^2.3.9",
    "luxon": "^3.7.1",
    "marked": "^17.0.6",
    "mermaid": "^11.9.0",
    "phoenix": "^1.7.21",
    "preact": "^11.0.1",
    "prettier": "^3.6.2",
    "progress": "^2.0.3",
    "puppeteer": "^25.1.0",
    "reveal.js": "^6.0.2",
    "tippy.js": "^6.3.7",
    "ts-pattern": "^5.8.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^26",
    "npm": ">= 11"
  }
}
