{
  "name": "@archidep/theme",
  "version": "0.0.0",
  "description": "Media engineering architecture and deployment course",
  "private": true,
  "scripts": {
    "build": "npm run build:emoji && npm run build:fonts && npm run build:main && npm run build:slides",
    "build:emoji": "node ./scripts/copy-emoji.mjs",
    "build:fonts": "node ./scripts/copy-fonts.mjs",
    "build:main": "tailwindcss --minify -i ./src/theme.css -o ../app/priv/static/assets/theme/theme.css",
    "build:slides": "tailwindcss --minify -i ./src/slides.css -o ../app/priv/static/assets/theme/slides.css",
    "start": "npm run build:emoji && npm run build:fonts && concurrently \"npm run start:main\" \"npm run start:slides\"",
    "start:main": "tailwindcss -i ./src/theme.css -o ../app/priv/static/assets/theme/theme.css --watch",
    "start:slides": "tailwindcss -i ./src/slides.css -o ../app/priv/static/assets/theme/slides.css --watch"
  },
  "dependencies": {
    "@fontsource-variable/bitcount-prop-single": "^5.3.0",
    "@fontsource/fjalla-one": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.0.5",
    "@tailwindcss/typography": "^0.5.16",
    "concurrently": "^10.0.3",
    "daisyui": "^5.0.9",
    "tailwindcss": "^4.0.5"
  },
  "engines": {
    "node": "^24",
    "npm": ">= 8"
  }
}
